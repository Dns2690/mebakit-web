---
import c from '../data/contenido.json';
const k = c.comparativa;
---
<section id="comparativa" class="seccion" aria-labelledby="h-comp">
  <div class="wrap">
    <div class="cabeza"><h2 id="h-comp">{k.h2}</h2></div>
    <div class="tabla-wrap">
      <table>
        <thead>
          <tr><td></td>{k.columnas.map((col, i) => <th scope="col" class={i === 2 ? 'destacada' : ''}>{col}</th>)}</tr>
        </thead>
        <tbody>
          {k.filas.map(([rasgo, ...vals]) => (
            <tr>
              <th scope="row">{rasgo}</th>
              {vals.map((v, i) => (
                <td class={`${i === 2 ? 'destacada' : ''} ${v === 'Sí' ? 'si' : v === 'No' ? 'no' : 'parcial'}`}>
                  <span class="marca" aria-hidden="true"></span>{v}
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>

<style>
  table { width: 100%; border-collapse: collapse; font-size: 1rem; }
  th, td { text-align: left; padding: var(--e-4) var(--e-4); border-bottom: 1px solid var(--linea-suave); vertical-align: top; }
  thead th { font: 600 0.95rem/1.3 var(--f-texto); border-bottom: 2px solid var(--tinta); }
  tbody th { font-weight: 500; width: 34%; }
  .destacada { background: rgba(31, 79, 191, 0.07); }
  thead .destacada { color: var(--azul); }
  .marca { display: inline-block; width: 10px; height: 10px; border-radius: 50%; margin-right: var(--e-2); border: 2px solid var(--azul); background: var(--azul); vertical-align: 0; }
  .no .marca { border-color: var(--gris-linea); background: transparent; }
  .parcial .marca { background: linear-gradient(90deg, var(--azul) 50%, transparent 50%); }
  @media (max-width: 640px) {
    thead { display: none; }
    tr { display: grid; grid-template-columns: repeat(3, 1fr); border-bottom: 1px solid var(--linea-suave); padding-block: var(--e-3); }
    tbody th { grid-column: 1 / -1; width: auto; border: 0; padding: 0 0 var(--e-2); }
    td { border: 0; padding: var(--e-2); font-size: 0.9rem; }
    td::before { display: block; font-size: 0.75rem; color: var(--gris-texto); }
    td:nth-of-type(1)::before { content: 'Separados'; }
    td:nth-of-type(2)::before { content: 'Banco fijo'; }
    td:nth-of-type(3)::before { content: 'MEBAKIT'; }
  }
</style>
