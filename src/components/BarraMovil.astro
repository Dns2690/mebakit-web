---
import c from '../data/contenido.json';
---
<div class="barra" hidden>
  <a class="boton" href="#contacto">{c.acciones.principal}</a>
</div>

<style>
  .barra { position: fixed; inset: auto 0 0 0; z-index: 40; padding: var(--e-3) var(--margen) calc(var(--e-3) + env(safe-area-inset-bottom)); background: color-mix(in srgb, var(--papel) 96%, transparent); border-top: 1px solid var(--linea-suave); }
  .barra .boton { width: 100%; }
  @media (min-width: 861px) { .barra { display: none; } }
</style>

<script>
  // Visible solo cuando ni el botón del hero ni el formulario están en pantalla.
  const barra = document.querySelector<HTMLElement>('.barra')!;
  const hero = document.querySelector('#inicio .acciones');
  const contacto = document.getElementById('contacto');
  const vistos = new Set<Element>();
  const io = new IntersectionObserver((entradas) => {
    entradas.forEach((e) => (e.isIntersecting ? vistos.add(e.target) : vistos.delete(e.target)));
    barra.hidden = vistos.size > 0;
  });
  if (hero) io.observe(hero);
  if (contacto) io.observe(contacto);
</script>
