---
import c from '../data/contenido.json';
import DiagramaProblema from './DiagramaProblema.astro';
const p = c.problema;
---
<section id="problema" class="seccion" aria-labelledby="h-problema">
  <div class="wrap">
    <div class="cabeza">
      <h2 id="h-problema">{p.h2}</h2>
      <p>{p.intro}</p>
    </div>
    <DiagramaProblema {...p.diagrama} />
    <ol class="puntos">
      {p.puntos.map((t) => <li>{t}</li>)}
    </ol>
  </div>
</section>

<style>
  .puntos { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 2px solid var(--tinta); }
  .puntos li { padding: var(--e-5) var(--e-5) 0 0; font: 600 clamp(1.25rem, 1vw + 1rem, 1.625rem)/1.3 var(--f-texto); letter-spacing: -0.01em; }
  .puntos li + li { padding-left: var(--e-5); border-left: 1px solid var(--linea-suave); }
  @media (max-width: 760px) {
    .puntos { grid-template-columns: 1fr; }
    .puntos li, .puntos li + li { padding: var(--e-5) 0; border-left: 0; border-bottom: 1px solid var(--linea-suave); }
  }
</style>
