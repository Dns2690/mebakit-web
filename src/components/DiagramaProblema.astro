---
// Esquema de línea: equipos separados → una sola caja MEBAKIT.
interface Props { antes: string; despues: string; etiquetas: string[] }
const { antes, despues, etiquetas } = Astro.props;
---
<svg class="diagrama" viewBox="0 0 960 340" role="img" aria-labelledby="dg-t">
  <title id="dg-t">{`${antes} → ${despues}`}</title>
  <g fill="none" stroke="var(--tinta)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    <!-- Fuente regulable -->
    <g transform="translate(20 40)">
      <rect x="0" y="0" width="150" height="96" rx="3" />
      <rect x="14" y="16" width="64" height="30" />
      <circle cx="112" cy="31" r="15" /><path d="M112 31 L120 22" />
      <circle cx="40" cy="72" r="7" /><circle cx="70" cy="72" r="7" />
      <circle cx="40" cy="72" r="2.5" fill="var(--rojo)" stroke="none" />
    </g>
    <!-- Soldadora por puntos -->
    <g transform="translate(200 52)">
      <rect x="0" y="0" width="120" height="84" rx="3" />
      <path d="M0 22 H120" /><circle cx="96" cy="52" r="6" />
      <path d="M24 84 C 20 120, 60 120, 70 150 M48 84 C 52 112, 90 118, 100 150" />
      <path d="M64 150 l6 14 M94 150 l6 14" stroke-width="3" />
    </g>
    <!-- Probador de LED -->
    <g transform="translate(40 190)">
      <rect x="0" y="0" width="96" height="64" rx="3" />
      <path d="M30 22 l14 10 l-14 10 z M44 22 v20" />
      <path d="M52 18 l8 -8 M58 26 l9 -5" />
      <path d="M96 40 C 130 40, 130 90, 170 90" />
    </g>
    <!-- Multímetro -->
    <g transform="translate(232 214)">
      <rect x="0" y="0" width="70" height="104" rx="10" />
      <rect x="12" y="12" width="46" height="24" />
      <circle cx="35" cy="66" r="14" /><path d="M35 66 L35 54" />
      <circle cx="20" cy="94" r="3" /><circle cx="50" cy="94" r="3" fill="var(--rojo)" stroke="none" />
    </g>
    <!-- Flecha -->
    <path d="M392 170 H540 M526 158 L540 170 L526 182" stroke="var(--gris-linea)" stroke-width="2" />
    <!-- MEBAKIT -->
    <g transform="translate(600 70)" stroke="var(--azul)" stroke-width="2">
      <rect x="0" y="22" width="320" height="18" rx="2" />
      <path d="M118 22 v-12 h22 v12 M180 22 v-12 h22 v12" />
      <rect x="0" y="44" width="320" height="170" rx="3" />
      <path d="M110 44 V214 M196 44 V214" />
      <rect x="30" y="66" width="40" height="14" /><rect x="138" y="66" width="36" height="14" />
      <circle cx="44" cy="150" r="7" /><circle cx="44" cy="180" r="7" />
      <circle cx="153" cy="150" r="7" /><circle cx="258" cy="110" r="6" />
      <circle cx="236" cy="170" r="7" /><circle cx="280" cy="170" r="7" />
      <circle cx="44" cy="150" r="2.5" fill="var(--rojo)" stroke="none" />
    </g>
  </g>
  <g font-family="var(--f-texto)" font-size="15" fill="var(--gris-texto)">
    <text x="20" y="24">{antes}</text>
    <text x="600" y="24" fill="var(--azul)" font-weight="600">{despues}</text>
    {etiquetas.map((t, i) => <text x={[655, 753, 858][i]} y="310" text-anchor="middle">{t}</text>)}
  </g>
</svg>

<style>
  .diagrama { width: 100%; height: auto; max-width: 1080px; }
</style>
