---
import c from '../data/contenido.json';
import k from '../data/contacto.json';
const iniciales = (n: string) => n.split(' ').filter((_, i, a) => i === 0 || i === a.length - 2).map((p) => p[0]).join('');
---
<section id="equipo" class="seccion" aria-labelledby="h-equipo">
  <div class="wrap">
    <div class="cabeza">
      <h2 id="h-equipo">{c.equipo.h2}</h2>
      <p>{c.equipo.intro}</p>
    </div>
    <ul class="personas">
      {k.equipo.map((p) => (
        <li>
          <span class="monograma" aria-hidden="true">{iniciales(p.nombre)}</span>
          <div>
            <h3>{p.nombre}</h3>
            <p class="gris">{p.rol || 'Ingeniería Mecatrónica'}</p>
            {p.linkedin && <a class="enlace" href={p.linkedin} rel="noopener" target="_blank">LinkedIn</a>}
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .personas { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 var(--e-7); max-width: 960px; }
  .personas li { display: grid; grid-template-columns: 56px 1fr; gap: var(--e-4); align-items: center; padding: var(--e-5) 0; border-top: 1px solid var(--linea-suave); }
  .monograma { width: 56px; height: 56px; border-radius: 50%; border: 1.5px solid var(--tinta); display: grid; place-items: center; font: 800 1rem/1 var(--f-display); font-stretch: 125%; }
  h3 { font-size: 1.125rem; font-family: var(--f-texto); font-stretch: 100%; font-weight: 600; letter-spacing: 0; }
  p { font-size: var(--t-chico); }
  @media (max-width: 700px) { .personas { grid-template-columns: 1fr; } }
</style>
