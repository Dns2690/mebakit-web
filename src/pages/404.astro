---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Base titulo="Página no encontrada — MEBAKIT">
  <main id="contenido" class="wrap texto">
    <h1>Esta página no existe</h1>
    <p>El enlace puede estar incompleto o la página se movió.</p>
    <p><a class="boton" href={base}>Ir a MEBAKIT</a></p>
  </main>
</Base>
<style>.texto { display: grid; gap: var(--e-5); padding-block: var(--e-10); }</style>
