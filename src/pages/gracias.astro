---
import Base from '../layouts/Base.astro';
import c from '../data/contenido.json';
import k from '../data/contacto.json';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const texto = c.gracias.texto.replace('{tiempoRespuesta}', k.tiempoRespuesta.replace(/\.$/, ''));
---
<Base titulo={`${c.gracias.titulo} — MEBAKIT`}>
  <main id="contenido" class="wrap texto">
    <h1>{c.gracias.titulo}</h1>
    <p class="gris">{texto}</p>
    <p><a class="boton" href={base}>{c.gracias.volver}</a></p>
  </main>
</Base>
<style>.texto { display: grid; gap: var(--e-5); padding-block: var(--e-10); } h1 { font-size: var(--t-h2); }</style>
