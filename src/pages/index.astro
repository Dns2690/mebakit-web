---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Problema from '../components/Problema.astro';
import Modulos from '../components/Modulos.astro';
import Uso from '../components/Uso.astro';
import Especificaciones from '../components/Especificaciones.astro';
import Comparativa from '../components/Comparativa.astro';
import Usuarios from '../components/Usuarios.astro';
import Proceso from '../components/Proceso.astro';
import Version2 from '../components/Version2.astro';
import Equipo from '../components/Equipo.astro';
import Cierre from '../components/Cierre.astro';
import BarraMovil from '../components/BarraMovil.astro';
import Pie from '../components/Pie.astro';
---
<Base>
  <Nav />
  <main id="contenido">
    <Hero />
    <Problema />
    <Modulos />
    <Uso />
    <Especificaciones />
    <Comparativa />
    <Usuarios />
    <Proceso />
    <Version2 />
    <Equipo />
    <Cierre />
  </main>
  <Pie />
  <BarraMovil />
</Base>
